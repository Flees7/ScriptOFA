forcePlaques
{
    type            forceCoeffs;
    libs            (libsampling.so libforces.so);
    writeControl    timeStep;
    writeInterval   1;
    log             yes;

    patches         (plaque1);
    rho             rhoInf;
    rhoInf          1.225;

    liftDir         (0 0 1);
    dragDir         (1 0 0);
    origin          (0 0 0);

    coordinateRotation
    {
        type    axes;
        e1      (1 0 0);
        e2      (0 1 0);
    }

    magUInf         20;
    lRef            1.0;  // Longueur de la plaque
    Aref            0.5; // Surface totale (5m x 5m)
}

